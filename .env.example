# Server
PORT=5000

# Public app URL (used in password-reset emails — required for mobile/production)
# Example: https://your-domain.com
APP_URL=http://localhost:5000

# Email (Gmail App Password — enable 2FA, then create at https://myaccount.google.com/apppasswords)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
# Optional custom from address (defaults to EMAIL_USER)
# EMAIL_FROM="Gharoo Care" <your-email@gmail.com>

# Or use custom SMTP instead of Gmail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# MongoDB Atlas
# Replace with your Atlas connection string from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gharoocare?retryWrites=true&w=majority

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Geoapify address autocomplete (client-side public key; optional fallback only)
VITE_GEOAPIFY_API_KEY=your-geoapify-api-key

# Server-only Google key. Enable Geocoding API and Places API; do NOT prefix this
# variable with VITE_. Add it to the deployment's environment variables too.
GOOGLE_MAPS_API_KEY=your-server-google-maps-api-key

# Optional browser-only key used solely for the draggable Google map. It is not
# required for GPS address auto-fill. Restrict it by your production HTTP referrers.
# Enable Maps JavaScript API and Places API if you use this option.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
