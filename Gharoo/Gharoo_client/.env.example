# Optional browser-only key for the draggable Google map. Restrict it by HTTP
# referrer. It is not needed for "Use Current Location" address auto-fill.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Keep this false for a testing key without Google Cloud billing. Address
# auto-fill will use the free server fallback instead of Google Geocoding.
VITE_ENABLE_GOOGLE_GEOCODER=false

# Optional public fallback key for Geoapify. Leave blank to use Nominatim if the
# server-side Google reverse-geocoding endpoint is unavailable.
VITE_GEOAPIFY_API_KEY=
